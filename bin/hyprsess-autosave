#!/bin/sh
# Autosave loop for systems without systemd (runit, OpenRC, s6...).
# Start it from Hyprland:  hl.exec_cmd("hyprsess-autosave 10")
# Usage: hyprsess-autosave [minutes]   (default 10)
set -u
MIN="${1:-${AUTOSAVE_MINUTES:-10}}"
case "$MIN" in ''|*[!0-9]*|0) echo "usage: $0 [minutes]" >&2; exit 1 ;; esac

# One loop per user: a second copy (e.g. after a Hyprland config reload) exits.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/hyprsess-autosave.lock"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK"
  flock -n 9 || exit 0
fi

BIN="$(dirname "$0")/hyprsess"
[ -x "$BIN" ] || BIN=hyprsess
while sleep $((MIN * 60)); do
  # Stop once the Hyprland session this loop belongs to is gone.
  hyprctl version >/dev/null 2>&1 || exit 0
  "$BIN" save autosave >/dev/null 2>&1
done
